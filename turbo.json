{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs", ".nvmrc"],
  "globalEnv": ["CI", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.{ts,tsx,mjs}", "!**/*.md", "!coverage/**"],
      "env": [
        "PRISM_DOCKER_STANDALONE",
        "PRISM_VERCEL_SERVICES",
        "NEXT_PUBLIC_CLIENT_PORTAL_URL",
        "NEXT_PUBLIC_SUPPLIER_PORTAL_URL",
        "NEXT_PUBLIC_GUEST_PORTAL_URL",
        "NEXT_PUBLIC_EVENT_PORTAL_URL"
      ],
      "outputs": [".next/**", "dist/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["P0_TEST_DATABASE_URL"],
      "outputs": ["coverage/**"]
    },
    "test:ci": {
      "dependsOn": ["^build"],
      "env": ["P0_TEST_DATABASE_URL"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check:boundaries": {
      "cache": false,
      "outputs": []
    }
  }
}
