{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "PRISM_DOCKER_STANDALONE",
        "PRISM_VERCEL_SERVICES",
        "NEXT_PUBLIC_CLIENT_PORTAL_URL",
        "NEXT_PUBLIC_SUPPLIER_PORTAL_URL",
        "NEXT_PUBLIC_GUEST_PORTAL_URL",
        "NEXT_PUBLIC_EVENT_PORTAL_URL"
      ],
      "outputs": [".next/**", "dist/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check:boundaries": {
      "cache": false,
      "outputs": []
    }
  }
}
