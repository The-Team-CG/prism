{
  "name": "prism",
  "version": "0.1.0",
  "private": true,
  "description": "P.R.I.S.M local-only event operations monorepo.",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:local:start": "node scripts/local-supabase.mjs start",
    "db:local:stop": "node scripts/local-supabase.mjs stop",
    "db:local:status": "node scripts/local-supabase.mjs status",
    "test:local-dev": "node --test scripts/local-supabase.test.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test:ci": "turbo run test:ci --concurrency=1",
    "dev": "turbo run dev --env-mode=loose",
    "dev:api": "npm --workspace prism-api run dev",
    "dev:api:watch": "concurrently -n types,api -c blue,green \"npm --workspace @prism/types run dev\" \"npm run dev:api\"",
    "dev:client": "npm --workspace @prism/client run dev",
    "dev:event": "npm --workspace @prism/event run dev",
    "dev:supplier": "npm --workspace @prism/supplier run dev",
    "dev:guest": "npm --workspace @prism/guest run dev",
    "start:api": "npm --workspace prism-api run start",
    "start:client": "npm --workspace @prism/client run start",
    "start:event": "npm --workspace @prism/event run start",
    "start:supplier": "npm --workspace @prism/supplier run start",
    "start:guest": "npm --workspace @prism/guest run start",
    "check:migrations": "npm --workspace prism-api run db:check:migrations",
    "check:migration-immutability": "npm --workspace prism-api run db:check:migration-immutability",
    "test:migrations": "node --test apps/api/scripts/check-prisma-migrations.test.mjs apps/api/scripts/check-migration-immutability.test.mjs",
    "check:domain-persistence": "npm --workspace prism-api run db:check:domain-persistence",
    "check:domain-persistence:final": "npm --workspace prism-api run db:check:domain-persistence:final",
    "test:domain-persistence": "npm --workspace prism-api run test:db:domain-persistence",
    "check:invariants": "npm --workspace prism-api run db:check:invariants:dry-run",
    "test:invariants": "node --test apps/api/scripts/check-data-invariants.test.mjs",
    "test:api": "npm --workspace prism-api run test",
    "check:test-clocks": "npm --workspace prism-api run check:test-clocks",
    "test:test-clocks": "node --test apps/api/scripts/check-test-clock-pinning.test.mjs",
    "test:api:coverage": "npm --workspace prism-api run test:coverage",
    "lint:architecture": "eslint --config eslint.config.mjs \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "db:generate": "npm --workspace prism-api run db:generate",
    "smoke:ui": "node scripts/smoke-prism-ui.mjs",
    "test:boundaries": "node --test scripts/check-prism-boundaries.test.mjs scripts/check-cyclomatic-complexity.test.mjs scripts/prism-ports.test.mjs scripts/prism-worktree.test.mjs scripts/port-ownership.test.mjs scripts/eslint-prism-architecture.test.mjs",
    "ports": "node scripts/prism-ports.mjs",
    "worktree:setup": "node scripts/prism-worktree.mjs setup",
    "worktree:setup:copy-local-env": "node scripts/prism-worktree.mjs setup --copy-local-env",
    "worktree:create": "node scripts/prism-worktree.mjs create",
    "worktree:remove": "node scripts/prism-worktree.mjs remove",
    "check:types-dist": "node scripts/check-types-dist.mjs",
    "check:boundaries": "node scripts/check-prism-boundaries.mjs",
    "check:complexity": "node scripts/check-cyclomatic-complexity.mjs",
    "check:query-audit": "npm --workspace prism-api run db:audit:queries",
    "postinstall": "npm --workspace @prism/types run build",
    "db:seed": "npm --workspace prism-api run db:seed --",
    "db:seed:verify": "npm --workspace prism-api run db:seed:verify --",
    "test:browser": "node scripts/e2e/browser/run.mjs",
    "test:browser:guards": "node --test scripts/e2e/browser/run.test.mjs scripts/e2e/browser/compare-timings.test.mjs",
    "check:push": "node scripts/ci/pre-push.mjs",
    "hooks:install": "node scripts/ci/install-hooks.mjs",
    "test:ci:guards": "node --test scripts/ci/*.test.mjs scripts/typescript.test.mjs scripts/verify-vitest-projects.test.mjs",
    "prepare": "node scripts/ci/install-hooks.mjs",
    "benchmark:typecheck": "node scripts/benchmark-typecheck.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "supabase": "2.122.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "bun": "1.4.4"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "fast-uri": "3.1.9",
    "prisma": {
      "mysql2": "3.24.6"
    },
    "qs": "^6.17.1",
    "nanoid": "^3.3.20",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "shell-quote": "^1.12.0",
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "minimatch": "^11.0.3",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "image-size": "2.1.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "bun@1.4.4": true
  }
}
