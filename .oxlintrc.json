{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react"],
  "jsPlugins": ["./scripts/oxlint-prism-architecture.mjs"],
  "categories": { "correctness": "off" },
  "rules": {
    "prism/no-cross-portal-imports": "error",
    "prism/no-private-context-imports": "error",
    "prism/no-local-contract-definitions": "error",
    "prism/no-inline-zod": "error",
    "prism/no-production-any": "error",
    "react/rules-of-hooks": "error",
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error"
  },
  "overrides": [{ "files": ["apps/api/**"], "rules": { "react/rules-of-hooks": "off" } }],
  "options": { "typeAware": true },
  "ignorePatterns": ["**/node_modules/**", "**/.next*/**", "**/dist/**", "**/.e2e-dist/**", "**/coverage/**", ".local-dev/**", ".worktrees/**", "output/**"]
}
