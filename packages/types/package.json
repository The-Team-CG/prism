{
  "name": "@prism/types",
  "version": "0.1.0",
  "private": true,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "node ../../scripts/typescript.mjs --compiler=legacy -p tsconfig.build.json",
    "dev": "node ../../scripts/typescript.mjs --compiler=legacy --watch -p tsconfig.build.json",
    "typecheck": "node ../../scripts/typescript.mjs -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "lint": "node ../../scripts/lint.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
