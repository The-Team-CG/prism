# Separate deployment example. Development generates .local-dev/docker.env.
# The start-prism wrappers never read or synchronize .env.docker.
DATABASE_URL=
# Optional migration-only override.
DIRECT_URL=
DB_SSL=true
DB_SSL_CA_FILE=

# Optional app/runtime flags.
ALLOW_POOLER_FOR_PRISMA=1
PARE_MODE=mock
