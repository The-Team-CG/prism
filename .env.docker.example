# Copy to .env.docker before running `docker compose -f compose.local.yml up --build`.
# Do not commit .env.docker.

# Runtime database connection. Supabase session pooler is acceptable for local API testing.
SUPABASE_DB_URL=
DATABASE_URL=
PRISMA_DATABASE_URL=
DIRECT_URL=
DB_SSL=true

# Optional app/runtime flags.
ALLOW_POOLER_FOR_PRISMA=1
PARE_MODE=mock
