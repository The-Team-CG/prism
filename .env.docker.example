# Copy to .env.docker (or run start-prism.cmd which creates it).
# Used by Docker compose for the API container. Do not commit .env.docker.

# Runtime database connection. Supabase session pooler is acceptable for local API testing.
SUPABASE_DB_URL=
DATABASE_URL=
PRISMA_DATABASE_URL=
DIRECT_URL=
DB_SSL=true
DB_SSL_CA_FILE=

# Optional app/runtime flags.
ALLOW_POOLER_FOR_PRISMA=1
PARE_MODE=mock
