{
  "name": "@prism/guest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/kill-prism-port.cjs --app guest --port 3003 && next dev --port 3003",
    "prebuild": "node ../../scripts/clean-next-dev.cjs",
    "build": "next build",
    "start": "node ../../scripts/kill-prism-port.cjs --app guest --port 3003 && next start --port 3003",
    "typecheck": "node ../../scripts/clean-next-dev.cjs && tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },

  "dependencies": {
    "@prism/api-client": "*",
    "@prism/tokens": "*",
    "@prism/types": "*",
    "@prism/ui": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "next": "^16.2.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}

