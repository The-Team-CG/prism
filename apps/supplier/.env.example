# P.R.I.S.M API used by browser-side supplier portal requests.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Vercel Services supplies same-origin browser routing through next.config.ts.
# PRISM_API_URL is a server-only service binding; never set it manually.
# NEXT_PUBLIC_PORTAL_BASE_PATH is supplied by next.config.ts in services mode.

# Portal sign-in links read these; all four are required. Local values match the dev ports.
NEXT_PUBLIC_CLIENT_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_SUPPLIER_PORTAL_URL=http://localhost:3002
NEXT_PUBLIC_GUEST_PORTAL_URL=http://localhost:3003
NEXT_PUBLIC_EVENT_PORTAL_URL=http://localhost:3004

# Optional PMCM account-help channel shown on sign-in, invitation and support screens.
# Leave blank to show plain "contact PMCM" guidance instead of links.
NEXT_PUBLIC_PMCM_SUPPORT_EMAIL=
NEXT_PUBLIC_PMCM_SUPPORT_PHONE=
