{
  "name": "@prism/supplier",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/dev-portal.mjs --app supplier --mode dev",
    "prebuild": "node ../../scripts/clean-next-dev.cjs",
    "build": "next build",
    "start": "node ../../scripts/dev-portal.mjs --app supplier --mode start",
    "typecheck": "node ../../scripts/clean-next-dev.cjs && tsc --noEmit",
    "lint": "cd ../.. && eslint --config eslint.config.mjs \"apps/supplier/src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prism/api-client": "*",
    "@prism/tokens": "*",
    "@prism/types": "*",
    "@prism/ui": "*",
    "@radix-ui/react-select": "^2.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "next": "^16.3.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
