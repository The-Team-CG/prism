                                                                                "libs/modules/closure-ops/src/*"
                                                                            ],
                                          "@prism/modules/event-core":  [
                                                                            "libs/modules/event-core/src/index"
                                                                        ],
                                          "@prism/modules/event-core/*":  [
                                                                              "libs/modules/event-core/src/*"
                                                                          ],
                                          "@prism/modules/trust-ops":  [
                                                                           "libs/modules/trust-ops/src/index"
                                                                       ],
                                          "@prism/modules/trust-ops/*":  [
                                                                             "libs/modules/trust-ops/src/*"
                                                                         ],
                                          "@prism/modules/notification-ops":  [
