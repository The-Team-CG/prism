{
    "compilerOptions":  {
                            "module":  "commonjs",
                            "moduleResolution":  "node",
                            "declaration":  true,
                            "removeComments":  true,
                            "emitDecoratorMetadata":  true,
                            "experimentalDecorators":  true,
                            "allowSyntheticDefaultImports":  true,
                            "target":  "ES2021",
                            "sourceMap":  true,
                            "outDir":  "./dist",
                            "baseUrl":  "./",
                            "ignoreDeprecations":  "6.0",
                            "incremental":  true,
                            "skipLibCheck":  true,
                            "strict":  true,
                            "useUnknownInCatchVariables":  true,
                            "forceConsistentCasingInFileNames":  true,
                            "noFallthroughCasesInSwitch":  true,
                            "paths":  {
                                          "@prism/shared":  [
                                                                "libs/shared/src/index"
                                                            ],
                                          "@prism/shared/*":  [
                                                                  "libs/shared/src/*"
                                                              ],
                                          "@prism/database":  [
                                                                  "libs/database/src/index"
                                                              ],
                                          "@prism/database/*":  [
                                                                    "libs/database/src/*"
                                                                ],
                                          "@prism/modules/plans":  [
                                                                       "libs/modules/plans/src/index"
                                                                   ],
                                          "@prism/modules/plans/*":  [
                                                                         "libs/modules/plans/src/*"
                                                                     ],
                                          "@prism/modules/templates":  [
                                                                           "libs/modules/templates/src/index"
                                                                       ],
                                          "@prism/modules/templates/*":  [
                                                                             "libs/modules/templates/src/*"
                                                                         ],
                                          "@prism/modules/events":  [
                                                                        "libs/modules/events/src/index"
                                                                    ],
                                          "@prism/modules/events/*":  [
                                                                          "libs/modules/events/src/*"
                                                                      ],
                                          "@prism/modules/sample-compatibility":  [
                                                                           "libs/modules/sample-compatibility/src/index"
                                                                       ],
                                          "@prism/modules/sample-compatibility/*":  [
                                                                             "libs/modules/sample-compatibility/src/*"
                                                                         ],
                                          "@prism/modules/publishing":  [
                                                                            "libs/modules/publishing/src/index"
                                                                        ],
                                          "@prism/modules/publishing/*":  [
                                                                              "libs/modules/publishing/src/*"
                                                                          ],
                                          "@prism/modules/health":  [
                                                                        "libs/modules/health/src/index"
                                                                    ],
                                          "@prism/modules/health/*":  [
                                                                          "libs/modules/health/src/*"
                                                                      ],
                                          "@prism/modules/event-read-models":  [
