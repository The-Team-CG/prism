                                                                          ],
                                          "@prism/modules/supplier-ops/*":  [
                                                                                "libs/modules/supplier-ops/src/*"
                                                                            ],
                                          "@prism/modules/finance-ops":  [
                                                                             "libs/modules/finance-ops/src/index"
                                                                         ],
                                          "@prism/modules/finance-ops/*":  [
                                                                               "libs/modules/finance-ops/src/*"
                                                                           ],
                                          "@prism/modules/file-ops":  [
