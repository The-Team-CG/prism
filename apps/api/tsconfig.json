{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "ignoreDeprecations": "6.0",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@prism/shared": [
        "libs/shared/src/index"
      ],
      "@prism/shared/*": [
        "libs/shared/src/*"
      ],
      "@prism/database": [
        "libs/database/src/index"
      ],
      "@prism/database/*": [
        "libs/database/src/*"
      ],
      "@prism/modules/sample-compatibility": [
        "libs/modules/sample-compatibility/src/index"
      ],
      "@prism/modules/sample-compatibility/*": [
        "libs/modules/sample-compatibility/src/*"
      ],
      "@prism/modules/health": [
        "libs/modules/health/src/index"
      ],
      "@prism/modules/health/*": [
        "libs/modules/health/src/*"
      ],
      "@prism/modules/event-read-models": [
        "libs/modules/event-read-models/src/index"
      ],
      "@prism/modules/event-read-models/*": [
        "libs/modules/event-read-models/src/*"
      ],
      "@prism/modules/closure-ops": [
        "libs/modules/closure-ops/src/index"
      ],
      "@prism/modules/closure-ops/*": [
        "libs/modules/closure-ops/src/*"
      ],
      "@prism/modules/event-core": [
        "libs/modules/event-core/src/index"
      ],
      "@prism/modules/event-core/*": [
        "libs/modules/event-core/src/*"
      ],
      "@prism/modules/trust-ops": [
        "libs/modules/trust-ops/src/index"
      ],
      "@prism/modules/trust-ops/*": [
        "libs/modules/trust-ops/src/*"
      ],
      "@prism/modules/notification-ops": [
        "libs/modules/notification-ops/src/index"
      ],
      "@prism/modules/notification-ops/*": [
        "libs/modules/notification-ops/src/*"
      ],
      "@prism/modules/access-control": [
        "libs/modules/access-control/src/index"
      ],
      "@prism/modules/access-control/*": [
        "libs/modules/access-control/src/*"
      ],
      "@prism/modules/ai-governance": [
        "libs/modules/ai-governance/src/index"
      ],
      "@prism/modules/ai-governance/*": [
        "libs/modules/ai-governance/src/*"
      ],
      "@prism/modules/file-ops": [
        "libs/modules/file-ops/src/index"
      ],
      "@prism/modules/file-ops/*": [
        "libs/modules/file-ops/src/*"
      ],
      "@prism/modules/inquiry-onboarding": [
        "libs/modules/inquiry-onboarding/src/index"
      ],
      "@prism/modules/inquiry-onboarding/*": [
        "libs/modules/inquiry-onboarding/src/*"
      ],
      "@prism/modules/compliance-ops": [
        "libs/modules/compliance-ops/src/index"
      ],
      "@prism/modules/compliance-ops/*": [
        "libs/modules/compliance-ops/src/*"
      ],
      "@prism/modules/identity-ops": [
        "libs/modules/identity-ops/src/index"
      ],
      "@prism/modules/identity-ops/*": [
        "libs/modules/identity-ops/src/*"
      ],
      "@prism/modules/event-session": [
        "libs/modules/event-session/src/index"
      ],
      "@prism/modules/event-session/*": [
        "libs/modules/event-session/src/*"
      ],
      "@prism/contexts/floorplan": [
        "libs/contexts/floorplan/src/index"
      ],
      "@prism/contexts/floorplan/*": [
        "libs/contexts/floorplan/src/*"
      ],
      "@prism/contexts/operations": [
        "libs/contexts/operations/src/index"
      ],
      "@prism/contexts/operations/*": [
        "libs/contexts/operations/src/*"
      ],
      "@prism/contexts/live-ops": [
        "libs/contexts/live-ops/src/index"
      ],
      "@prism/contexts/live-ops/*": [
        "libs/contexts/live-ops/src/*"
      ],
      "@prism/contexts/commercial": [
        "libs/contexts/commercial/src/index"
      ],
      "@prism/contexts/commercial/*": [
        "libs/contexts/commercial/src/*"
      ]
    }
  }
}
