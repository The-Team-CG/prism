{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "ignoreDeprecations": "6.0",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@prism/kernel/shared": [
        "src/kernel/shared/index"
      ],
      "@prism/kernel/shared/*": [
        "src/kernel/shared/*"
      ],
      "@prism/kernel/database": [
        "src/kernel/database/index"
      ],
      "@prism/kernel/database/*": [
        "src/kernel/database/*"
      ],
      "@prism/kernel/event-core": [
        "src/kernel/event-core/index"
      ],
      "@prism/kernel/event-core/*": [
        "src/kernel/event-core/*"
      ],
      "@prism/kernel/access-control": [
        "src/kernel/access-control/index"
      ],
      "@prism/kernel/access-control/*": [
        "src/kernel/access-control/*"
      ],
      "@prism/kernel/event-session": [
        "src/kernel/event-session/index"
      ],
      "@prism/kernel/event-session/*": [
        "src/kernel/event-session/*"
      ],
      "@prism/kernel/health": [
        "src/kernel/health/index"
      ],
      "@prism/kernel/health/*": [
        "src/kernel/health/*"
      ],
      "@prism/kernel/shared-kernel": [
        "src/kernel/shared-kernel/index"
      ],
      "@prism/kernel/shared-kernel/*": [
        "src/kernel/shared-kernel/*"
      ],
      "@prism/contexts/floorplan": [
        "src/modules/floorplan/index"
      ],
      "@prism/contexts/floorplan/*": [
        "src/modules/floorplan/*"
      ],
      "@prism/contexts/operations": [
        "src/modules/operations/index"
      ],
      "@prism/contexts/operations/*": [
        "src/modules/operations/*"
      ],
      "@prism/contexts/live-ops/urgent-issue-reference": [
        "src/modules/live-ops/urgent-issue-reference"
      ],
      "@prism/contexts/live-ops": [
        "src/modules/live-ops/index"
      ],
      "@prism/contexts/live-ops/*": [
        "src/modules/live-ops/*"
      ],
      "@prism/contexts/commercial": [
        "src/modules/commercial/index"
      ],
      "@prism/contexts/commercial/*": [
        "src/modules/commercial/*"
      ],
      "@prism/contexts/event-lifecycle/post-event-reference": [
        "src/modules/event-lifecycle/post-event-reference"
      ],
      "@prism/contexts/event-lifecycle/operations-reference": [
        "src/modules/event-lifecycle/operations-reference"
      ],
      "@prism/contexts/commercial/registration-supplier-reference": [
        "src/modules/commercial/registration-supplier-reference"
      ],
      "@prism/contexts/event-lifecycle": [
        "src/modules/event-lifecycle/index"
      ],
      "@prism/contexts/event-lifecycle/floorplan-reference": [
        "src/modules/event-lifecycle/floorplan-reference"
      ],
      "@prism/contexts/event-lifecycle/*": [
        "src/modules/event-lifecycle/*"
      ],
      "@prism/contexts/platform-ops": [
        "src/modules/platform-ops/index"
      ],
      "@prism/contexts/platform-ops/*": [
        "src/modules/platform-ops/*"
      ],
      "@prism/contexts/identity-access/coordinator-reference": [
        "src/modules/identity-access/coordinator-reference"
      ],
      "@prism/contexts/identity-access": [
        "src/modules/identity-access/index"
      ],
      "@prism/contexts/identity-access/*": [
        "src/modules/identity-access/*"
      ],
      "@prism/contexts/read-models/guest-events": [
        "src/modules/read-models/guest-events"
      ],
      "@prism/contexts/read-models": [
        "src/modules/read-models/index"
      ],
      "@prism/contexts/read-models/*": [
        "src/modules/read-models/*"
      ]
    }
  }
}
