{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "ignoreDeprecations": "6.0",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@prism/shared": [
        "libs/shared/src/index"
      ],
      "@prism/shared/*": [
        "libs/shared/src/*"
      ],
      "@prism/database": [
        "libs/database/src/index"
      ],
      "@prism/database/*": [
        "libs/database/src/*"
      ],
      "@prism/modules/sample-compatibility": [
        "libs/modules/sample-compatibility/src/index"
      ],
      "@prism/modules/sample-compatibility/*": [
        "libs/modules/sample-compatibility/src/*"
      ],
      "@prism/modules/health": [
        "libs/modules/health/src/index"
      ],
      "@prism/modules/health/*": [
        "libs/modules/health/src/*"
      ],
      "@prism/modules/event-read-models": [
        "libs/modules/event-read-models/src/index"
      ],
      "@prism/modules/event-read-models/*": [
        "libs/modules/event-read-models/src/*"
      ],
      "@prism/modules/event-core": [
        "libs/modules/event-core/src/index"
      ],
      "@prism/modules/event-core/*": [
        "libs/modules/event-core/src/*"
      ],
      "@prism/modules/access-control": [
        "libs/modules/access-control/src/index"
      ],
      "@prism/modules/access-control/*": [
        "libs/modules/access-control/src/*"
      ],
      "@prism/modules/event-session": [
        "libs/modules/event-session/src/index"
      ],
      "@prism/modules/event-session/*": [
        "libs/modules/event-session/src/*"
      ],
      "@prism/contexts/floorplan": [
        "libs/contexts/floorplan/src/index"
      ],
      "@prism/contexts/floorplan/*": [
        "libs/contexts/floorplan/src/*"
      ],
      "@prism/contexts/operations": [
        "libs/contexts/operations/src/index"
      ],
      "@prism/contexts/operations/*": [
        "libs/contexts/operations/src/*"
      ],
      "@prism/contexts/live-ops": [
        "libs/contexts/live-ops/src/index"
      ],
      "@prism/contexts/live-ops/*": [
        "libs/contexts/live-ops/src/*"
      ],
      "@prism/contexts/commercial": [
        "libs/contexts/commercial/src/index"
      ],
      "@prism/contexts/commercial/*": [
        "libs/contexts/commercial/src/*"
      ],
      "@prism/contexts/event-lifecycle": [
        "libs/contexts/event-lifecycle/src/index"
      ],
      "@prism/contexts/event-lifecycle/*": [
        "libs/contexts/event-lifecycle/src/*"
      ],
      "@prism/contexts/platform-ops": [
        "libs/contexts/platform-ops/src/index"
      ],
      "@prism/contexts/platform-ops/*": [
        "libs/contexts/platform-ops/src/*"
      ],
      "@prism/contexts/identity-access": [
        "libs/contexts/identity-access/src/index"
      ],
      "@prism/contexts/identity-access/*": [
        "libs/contexts/identity-access/src/*"
      ]
    }
  }
}
