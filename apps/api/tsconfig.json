                                                                                ],
                                          "@prism/modules/inquiry-onboarding/*":  [
                                                                                      "libs/modules/inquiry-onboarding/src/*"
                                                                                  ],
                                          "@prism/modules/commercial-ops":  [
                                                                                "libs/modules/commercial-ops/src/index"
                                                                            ],
                                          "@prism/modules/commercial-ops/*":  [
                                                                                  "libs/modules/commercial-ops/src/*"
                                                                              ],
                                          "@prism/modules/compliance-ops":  [
                                                                                "libs/modules/compliance-ops/src/index"
                                                                            ],
                                          "@prism/modules/compliance-ops/*":  [
                                                                                  "libs/modules/compliance-ops/src/*"
                                                                              ],
                                          "@prism/modules/floorplan":  [
                                                                            "libs/modules/floorplan/src/index"
                                                                        ],
                                          "@prism/modules/floorplan/*":  [
                                                                              "libs/modules/floorplan/src/*"
                                                                          ],
                                          "@prism/modules/guest-ops":  [
                                                                               "libs/modules/guest-ops/src/index"
                                                                           ],
                                          "@prism/modules/guest-ops/*":  [
                                                                                 "libs/modules/guest-ops/src/*"
                                                                             ],
                                          "@prism/modules/identity-ops":  [
                                                                                  "libs/modules/identity-ops/src/index"
                                                                              ],
                                          "@prism/modules/identity-ops/*":  [
                                                                                    "libs/modules/identity-ops/src/*"
                                                                                ],
                                          "@prism/modules/staffing-ops":  [
                                                                                 "libs/modules/staffing-ops/src/index"
                                                                             ],
                                          "@prism/modules/staffing-ops/*":  [
                                                                                   "libs/modules/staffing-ops/src/*"
                                                                               ],
                                          "@prism/modules/live-ops":  [
                                                                              "libs/modules/live-ops/src/index"
                                                                          ],
                                          "@prism/modules/live-ops/*":  [
