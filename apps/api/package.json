{
    "name": "prism-api",
    "version": "1.0.0",
    "description": "p.r.i.s.m backend — NestJS monorepo",
    "private": true,
    "scripts": {
        "dev": "node scripts/start-prism-api.cjs --mode dev",
        "build": "nest build api",
        "start": "node scripts/start-prism-api.cjs --mode start",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run",
        "check:test-clocks": "node scripts/check-test-clock-pinning.mjs",
        "test:coverage": "vitest run --coverage",
        "prisma:validate": "prisma validate",
        "validate": "npm run prisma:validate && npm run typecheck && npm run build",
        "smoke": "node scripts/smoke-api.mjs",
        "db:seed:fixtures": "npm run build && node scripts/run-with-env.mjs scripts/seed-local-fixtures.mjs",
        "test:fixtures:seed": "node --test scripts/seed-local-fixtures.test.mjs",
        "test:db:connection": "node --test scripts/db-connection-config.test.mjs",
        "test:db:preflight:quote-request-fk": "node --test scripts/db-preflight-quote-request-fk.test.mjs",
        "test:db:backup-catalog": "node --test scripts/db-backup-catalog.test.mjs",
        "test:db:preflight:ddd": "node --test scripts/db-preflight-ddd.test.mjs",
        "test:db:schema-equivalence": "node --test scripts/db-schema-equivalence.test.mjs",
        "db:verify:schema": "node scripts/db-schema-equivalence.mjs",
        "db:integrity:ci": "node scripts/run-db-integrity-ci.mjs",
        "test:db:integration": "node scripts/run-db-behavior-tests.mjs",
        "db:preflight:quote-request-fk": "node scripts/run-with-env.mjs scripts/db-preflight-quote-request-fk.mjs",
        "db:doctor": "node scripts/run-with-env.mjs scripts/db-doctor.mjs",
        "db:doctor:runtime": "node scripts/run-with-env.mjs scripts/db-doctor.mjs --mode=runtime",
        "db:status": "npm run db:doctor && prisma migrate status",
        "db:setup": "npm run db:doctor && prisma migrate deploy",
        "db:migrate": "npm run db:doctor && prisma migrate dev",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:generate": "prisma generate",
        "db:verify:offline": "npm run prisma:validate && prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
        "db:verify": "npm run db:doctor && npm run prisma:validate && prisma migrate status && npm run db:verify:offline",
        "db:check:migrations": "node scripts/check-prisma-migrations.mjs",
        "db:check:domain-persistence": "node scripts/check-domain-persistence.mjs --final",
        "db:check:domain-persistence:final": "node scripts/check-domain-persistence.mjs --final",
        "test:db:domain-persistence": "node --test scripts/check-domain-persistence.test.mjs scripts/domain-persistence-catalog.test.mjs",
        "db:check:references": "node scripts/check-domain-reference-policy.mjs",
        "test:db:reference-policy": "node --test scripts/check-domain-reference-policy.test.mjs",
        "db:check:invariants": "node scripts/run-with-env.mjs scripts/check-data-invariants.mjs",
        "db:check:invariants:dry-run": "node scripts/check-data-invariants.mjs --dry-run",
        "db:preflight:ddd": "node scripts/db-preflight-ddd.mjs",
        "db:audit:repair": "npm run build && node scripts/run-with-env.mjs scripts/repair-audit-chain.mjs",
        "db:diff:live": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
        "db:audit:schemas": "node scripts/run-with-env.mjs scripts/db-schema-audit.mjs",
        "db:audit:naming": "node scripts/run-with-env.mjs scripts/db-naming-audit.mjs",
        "db:audit:indexes": "node scripts/run-with-env.mjs scripts/db-index-audit.mjs",
        "db:audit:queries": "node scripts/db-query-audit.mjs",
        "test:db:query-audit": "node --test scripts/db-query-audit.test.mjs",
        "db:perf:report": "node scripts/run-with-env.mjs scripts/db-performance-report.mjs",
        "db:reset": "node scripts/require-ack.mjs db:reset PRISM_API_DB_RESET_I_UNDERSTAND && npm run db:doctor && prisma migrate reset --force --skip-generate",
    "db:reset:2fa": "node scripts/require-ack.mjs db:reset:2fa PRISM_API_2FA_RESET_I_UNDERSTAND && node scripts/run-with-env.mjs scripts/reset-local-fixture-2fa.mjs",
        "postinstall": "prisma generate",
        "db:backup:json": "node scripts/run-with-env.mjs scripts/db-backup-json.mjs",
        "test:db:audit-repair": "node --test scripts/repair-audit-chain.test.mjs"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.95.0",
        "@nestjs/common": "^11.2.5",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.2.5",
        "@nestjs/platform-express": "^11.2.5",
        "@prism/types": "*",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "pg": "^8.16.0",
        "prisma": "^7.8.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.21",
        "@nestjs/schematics": "^11.1.0",
        "@types/express": "^5.0.6",
        "@types/node": "^25.6.0",
        "@types/pg": "^8.15.1",
        "@vitest/coverage-v8": "^4.1.10",
        "source-map-support": "^0.5.21",
        "ts-loader": "^9.5.2",
        "typescript": "^6.0.3",
        "vitest": "^4.1.5"
    }
}
