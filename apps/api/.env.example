# start-prism generates ignored local Supabase environments for development.
# Deployments use one DATABASE_URL for runtime and Prisma.
DATABASE_URL="postgresql://postgres.project-ref:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
# Optional migration-only override when migration connectivity differs.
DIRECT_URL=""

# Set to 1 only when the selected Prisma URL intentionally uses a Supabase
# pooler/pgbouncer connection (for example, a free-tier local setup).
ALLOW_POOLER_FOR_PRISMA=""

# Optional shadow database URL for advanced migration diff workflows
SHADOW_DATABASE_URL=""

# Hosted database connections always verify their certificate. Set false only for a loopback Postgres target.
DB_SSL=true
# Optional absolute path to a trusted PEM CA certificate for hosted PostgreSQL.
DB_SSL_CA_FILE=""

# Required for local dev session signing (auth-session.service.ts).
# 'development' enables the local development session secret fallback.
NODE_ENV=development

PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# Set to 1 to disable the commercial payment-risk sweep scheduler.
PRISM_DISABLE_PAYMENT_RISK_JOB=0

# Set to 1 to disable scheduled coordinator acknowledgement reminders.
PRISM_DISABLE_COORDINATOR_ACKNOWLEDGEMENT_JOB=0
# Pending coordinators are reminded this many days before their event (0-365; default 7).
PRISM_COORDINATOR_ACKNOWLEDGEMENT_LEAD_TIME_DAYS=7

# Set to 1 to disable scheduled supplier ingress late flags.
PRISM_DISABLE_SUPPLIER_INGRESS_LATE_JOB=0
# Mark suppliers late this many minutes after their scheduled ingress (0-1440; default 15).
PRISM_SUPPLIER_INGRESS_LATE_GRACE_MINUTES=15

# Set to 1 to disable the overdue event-day task sweep that queues PMCM outbox notifications.
PRISM_DISABLE_LIVE_OPS_OVERDUE_TASK_JOB=0

# AI defaults to the deterministic mock. In NODE_ENV=development, a single
# supported provider key selects that provider's synthetic-only profile. If both
# keys are present, set AI_PROVIDER to anthropic or openrouter. Staging and
# production never infer activation from a key.
AI_ROUTE_PROFILE=mock
AI_PROVIDER=
# Optional model override for all routes. Tier-specific values take precedence.
AI_MODEL=
AI_MODEL_FAST=
AI_MODEL_STRONG=
AI_LIVE_USE_CASES=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Development fixtures are inserted only by the explicit guarded seed command:
# npm --workspace prism-api run db:seed:fixtures -- --confirm-disposable-db prism_sample_disposable
# The effective runtime database URL must use a loopback host and this exact
# database name. The command refuses production and any non-empty fixture tables.

# Acknowledgement gate for `npm run db:reset:2fa`, which clears 2FA enrolment and
# lockout state for seeded test (*.test / *@pmcm.test) accounts only. Set to 1 to allow.
PRISM_API_2FA_RESET_I_UNDERSTAND=""

# Storage is unconfigured by default. Set provider to local for development
# and choose an absolute directory in the checkout's ignored .local-dev folder.
# For a private hosted bucket, select supabase and configure server-only secrets.
# See docs/runbooks/portal-storage.md for activation verification.
PRISM_STORAGE_PROVIDER=""
PRISM_STORAGE_LOCAL_DIRECTORY=""

# Exact startup migration-ledger validation is reserved for a controlled schema
# cutover. Leave disabled for ordinary backward-compatible deployments.
PRISM_SCHEMA_COMPATIBILITY_MODE=disabled
PRISM_SCHEMA_REQUIRED_HEAD=
PRISM_STORAGE_SUPABASE_URL=""
PRISM_STORAGE_SUPABASE_SERVICE_ROLE_KEY=""
PRISM_STORAGE_SUPABASE_BUCKET=""
