SUPABASE_PROJECT_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Runtime connection used by API services (pooler URL from Supabase)
SUPABASE_DB_URL="postgresql://postgres.your-project-ref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Fallback alias for runtime (optional if SUPABASE_DB_URL is set)
DATABASE_URL="postgresql://postgres.your-project-ref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Prisma CLI migration and schema-check URL. Prefer the direct postgres host;
# use a pooler here only when the explicit ALLOW_POOLER_FOR_PRISMA override is set.
DIRECT_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres"

# Optional explicit override for Prisma CLI commands. When set, this takes
# precedence over DIRECT_URL for db:doctor and Prisma CLI commands.
PRISMA_DATABASE_URL=""

# Set to 1 only when the selected Prisma URL intentionally uses a Supabase
# pooler/pgbouncer connection (for example, a free-tier local setup).
ALLOW_POOLER_FOR_PRISMA=""

# Optional shadow database URL for advanced migration diff workflows
SHADOW_DATABASE_URL=""

DB_SSL=true

# Required for local dev session signing (auth-session.service.ts).
# 'development' enables the local sample session secret fallback.
NODE_ENV=development

PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# AI defaults to the deterministic mock. In NODE_ENV=development, a single
# supported provider key selects that provider's synthetic-only profile. If both
# keys are present, set AI_PROVIDER to anthropic or openrouter. Staging and
# production never infer activation from a key.
AI_ROUTE_PROFILE=mock
AI_PROVIDER=
# Optional model override for all routes. Tier-specific values take precedence.
AI_MODEL=
AI_MODEL_FAST=
AI_MODEL_STRONG=
AI_LIVE_USE_CASES=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Local-only escape hatch for the explicit sample fixture reset command.
#
# The API accepts reset requests only outside production when its effective
# runtime database URL uses a loopback host and the exact database name
# `prism_sample_disposable`. The first nonempty URL wins in this order:
# SUPABASE_DB_URL, DATABASE_URL, PRISMA_DATABASE_URL, then DIRECT_URL, matching
# PrismaService. Clear any earlier remote URL before using the local reset.
#
# The explicit client command also requires:
#   npm --workspace prism-api run sample:fixtures:reset -- --confirm-disposable-db prism_sample_disposable
#
# Point the API at an already-created and migrated disposable local database
# before running the command. The sample values above point to a remote project,
# so the API will refuse reset until the effective runtime URL is local.
#
# Leave empty to keep the reset command disabled. This key is required alongside
# the exact command confirmation and is always refused when NODE_ENV=production.
PRISM_DEV_RESET_KEY=""

# Optional target for the local fixture reset command; it defaults to localhost.
PRISM_API_URL="http://localhost:4000"

# Acknowledgement gate for `npm run db:reset:2fa`, which clears 2FA enrolment and
# lockout state for sample (*.test / *@pmcm.test) accounts only. Set to 1 to allow.
PRISM_API_2FA_RESET_I_UNDERSTAND=""

# Local-only anonymous read of GET /sample/state.
#
# That endpoint now requires a verified PmcmAdmin/System session. It previously
# had no guard at all, on the reasoning that it is disabled in production - which
# left it open on staging while returning the full user directory and every
# supplier quote request's accessToken. That token is the entire authorization
# for GET/POST/PATCH /quote-requests/:token, so an anonymous read handed out
# working credentials for submitting and revising supplier quotes.
#
# Set to exactly 1 only on your own machine. Any other value, or NODE_ENV=production,
# disables it. Every anonymous read is logged at warn level.
PRISM_ALLOW_ANONYMOUS_SAMPLE_STATE=""

# W10 storage is intentionally unconfigured by default. For development only,
# set both values to bind the local filesystem adapter; it is not production
# object storage and no external provider credentials belong in this file.
PRISM_STORAGE_PROVIDER=""
PRISM_STORAGE_LOCAL_DIRECTORY=""
