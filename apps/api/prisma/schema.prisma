generator client {
  provider = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "commercial", "event_lifecycle", "floorplan", "identity_access", "live_ops", "operations", "platform_ops"]
}

model FloorPlan {
  id             String   @id
  name           String
  venue          String   @default("")
  width          Int      @default(1400)
  height         Int      @default(900)
  gridSize       Int      @default(20) @map("grid_size")
  pax            Int      @default(0)
  ownerId        String   @map("owner_id")
  templateId     String?  @map("template_id")
  eventId        String?  @map("event_id")
  objects        Json     @default("[]")
  guests         Json     @default("[]")
  suppliers      Json     @default("[]")
  seats          Json     @default("[]")
  seatCategories Json     @default("[]") @map("seat_categories")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  objectRows FloorPlanObject[]
  asTemplate VenueTemplate?     @relation("TemplateBaseLayout")
  asEvent    EventInstance?     @relation("EventLayout")
  opsDraft   OpsFloorPlanDraft? @relation("OpsDraftLayout")

  @@map("floor_plans")
  @@schema("floorplan")
}

model FloorPlanObject {
  floorPlanId String   @map("floor_plan_id")
  objectId    String   @map("object_id")
  kind        String
  zIndex      Int      @default(0) @map("z_index")
  objectData  Json     @map("object_data")
  svgMarkup   String?  @map("svg_markup")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  floorPlan FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)

  @@id([floorPlanId, objectId])
  @@map("floor_plan_objects")
  @@schema("floorplan")
}

model VenueTemplate {
  id                String   @id
  ownerId           String   @map("owner_id")
  name              String
  description       String   @default("")
  venue             String   @default("")
  venueRules        String   @default("") @map("venue_rules")
  permanentFeatures Json     @default("[]") @map("permanent_features")
  floorPlanId       String   @unique @map("floor_plan_id")
  pax               Int      @default(0)
  includeGuests     Boolean  @default(false) @map("include_guests")
  includeSuppliers  Boolean  @default(false) @map("include_suppliers")
  guests            Json     @default("[]")
  suppliers         Json     @default("[]")
  sourceType        String   @default("custom") @map("source_type")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  floorPlan FloorPlan       @relation("TemplateBaseLayout", fields: [floorPlanId], references: [id], onDelete: Cascade)
  events    EventInstance[]

  @@map("venue_templates")
  @@schema("floorplan")
}

model EventInstance {
  id          String   @id
  ownerId     String   @map("owner_id")
  templateId  String   @map("template_id")
  floorPlanId String   @unique @map("floor_plan_id")
  name        String
  startsAt    DateTime @map("starts_at")
  status      String   @default("draft")
  createdAt   DateTime @default(now()) @map("created_at")

  template  VenueTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  floorPlan FloorPlan          @relation("EventLayout", fields: [floorPlanId], references: [id], onDelete: Cascade)
  snapshot  PublishedSnapshot?

  @@index([templateId], map: "event_instances_template_id_idx")
  @@map("event_instances")
  @@schema("floorplan")
}

model PublishedSnapshot {
  id          String   @id
  slug        String   @unique
  eventId     String   @unique @map("event_id")
  floorPlan   Json     @map("floor_plan")
  publishedAt DateTime @default(now()) @map("published_at")

  event EventInstance @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("published_snapshots")
  @@schema("floorplan")
}

model OpsUser {
  id               String    @id
  name             String
  email            String    @unique(map: "users_email_key")
  password         String
  role             String
  organization     String
  approvalStatus   String    @default("pending") @map("approval_status")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockoutCount     Int       @default(0) @map("lockout_count")
  lockedUntil      DateTime? @map("locked_until")
  permanentLockout Boolean   @default(false) @map("permanent_lockout")
  lastLoginAt      DateTime? @map("last_login_at")
  twoFactorSecret  String?   @map("two_factor_secret")
  sessionVersion   Int       @default(0) @map("session_version")
  twoFactorChallengeHash       String?   @unique(map: "users_two_factor_challenge_hash_key") @map("two_factor_challenge_hash")
  twoFactorChallengeExpiresAt  DateTime? @map("two_factor_challenge_expires_at")
  twoFactorChallengeAttempts   Int       @default(0) @map("two_factor_challenge_attempts")
  twoFactorChallengeConsumedAt DateTime? @map("two_factor_challenge_consumed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  passwordResetTokens OpsPasswordResetToken[]
  approvalRequests    OpsApprovalRequest[]

  @@map("users")
  @@schema("identity_access")
}

model OpsPasswordResetToken {
  id         String    @id
  userId     String    @map("user_id")
  tokenHash  String    @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user OpsUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "password_reset_tokens_user_id_expires_at_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
  @@schema("identity_access")
}

model OpsPasswordResetRateLimit {
  id              String   @id
  normalizedEmail String   @map("normalized_email")
  clientIp        String   @map("client_ip")
  windowStartedAt DateTime @map("window_started_at")
  requestCount    Int      @default(0) @map("request_count")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([normalizedEmail, clientIp], map: "password_reset_rate_limits_email_ip_key")
  @@index([windowStartedAt], map: "password_reset_rate_limits_window_started_at_idx")
  @@map("password_reset_rate_limits")
  @@schema("identity_access")
}

model OpsApprovalRequest {
  id                       String   @id
  userId                   String   @map("user_id")
  name                     String
  email                    String
  role                     String
  organization             String
  status                   String   @default("pending")
  privacyConsentAccepted   Boolean  @default(false) @map("privacy_consent_accepted")
  privacyNoticeVersion     String   @default("") @map("privacy_notice_version")
  marketingConsentAccepted Boolean  @default(false) @map("marketing_consent_accepted")
  requestedAt              DateTime @default(now()) @map("requested_at")

  user OpsUser @relation(fields: [userId], references: [id], onDelete: Restrict, map: "approval_requests_user_id_fkey")

  @@index([status, requestedAt], map: "approval_requests_status_requested_at_idx")
  @@index([userId], map: "approval_requests_user_id_idx")
  @@map("approval_requests")
  @@schema("identity_access")
}

model OpsInquiry {
  id                        String    @id
  clientName                String    @map("client_name")
  companyName               String    @default("") @map("company_name")
  email                     String
  eventName                 String    @map("event_name")
  eventType                 String    @default("Event") @map("event_type")
  eventDate                 DateTime  @map("event_date")
  clientType                String    @map("client_type")
  source                    String    @default("Website")
  channel                   String?
  normalizedEmail           String    @default("") @map("normalized_email")
  referralDetails           String    @default("") @map("referral_details")
  loggedByRole              String?   @map("logged_by_role")
  loggedByName              String?   @map("logged_by_name")
  duplicateOfInquiryId      String?   @map("duplicate_of_inquiry_id")
  previousDeclinedInquiryId String?   @map("previous_declined_inquiry_id")
  previousDeclineReason     String?   @map("previous_decline_reason")
  message                   String    @default("")
  status                    String    @default("new")
  declineReason             String?   @map("decline_reason")
  acceptedAt                DateTime? @map("accepted_at")
  pendingAt                 DateTime? @map("pending_at")
  declinedAt                DateTime? @map("declined_at")
  conformeSentAt            DateTime? @map("conforme_sent_at")
  conformeSignedAt          DateTime? @map("conforme_signed_at")
  portalActivatedAt         DateTime? @map("portal_activated_at")
  followUpIntervalDays      Int       @default(3) @map("follow_up_interval_days")
  lastConformeReminderAt    DateTime? @map("last_conforme_reminder_at")
  portalInvitationStatus    String    @default("not_sent") @map("portal_invitation_status")
  portalInvitationSentAt    DateTime? @map("portal_invitation_sent_at")
  portalInvitationOpenedAt  DateTime? @map("portal_invitation_opened_at")
  portalInvitationExpiresAt DateTime? @map("portal_invitation_expires_at")
  privacyConsentAccepted    Boolean   @default(false) @map("privacy_consent_accepted")
  privacyNoticeVersion      String    @default("") @map("privacy_notice_version")
  marketingConsentAccepted  Boolean   @default(false) @map("marketing_consent_accepted")
  createdAt                 DateTime  @default(now()) @map("created_at")

  events OpsEvent[]
  statusHistory OpsInquiryStatusHistory[]

  @@index([status, createdAt], map: "inquiries_status_created_at_idx")
  @@index([source, createdAt], map: "inquiries_source_created_at_idx")
  @@index([clientType, createdAt], map: "inquiries_client_type_created_at_idx")
  @@index([normalizedEmail, eventDate], map: "inquiries_normalized_email_event_date_idx")
  @@index([duplicateOfInquiryId], map: "inquiries_duplicate_of_inquiry_id_idx")
  @@index([previousDeclinedInquiryId], map: "inquiries_previous_declined_inquiry_id_idx")
  @@map("inquiries")
  @@schema("event_lifecycle")
}

model OpsInquiryStatusHistory {
  id            String   @id
  inquiryId     String   @map("inquiry_id")
  eventId       String?  @map("event_id")
  fromStatus    String?  @map("from_status")
  toStatus      String   @map("to_status")
  transition    String
  actorId       String?  @map("actor_id")
  actorRole     String?  @map("actor_role")
  actorName     String?  @map("actor_name")
  createdAt     DateTime @default(now()) @map("created_at")

  inquiry OpsInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt], map: "inquiry_status_history_inquiry_id_created_at_idx")
  @@index([eventId, createdAt], map: "inquiry_status_history_event_id_created_at_idx")
  @@map("inquiry_status_history")
  @@schema("event_lifecycle")
}

model OpsEvent {
  id                    String    @id
  inquiryId             String    @map("inquiry_id")
  clientName            String    @map("client_name")
  eventName             String    @map("event_name")
  eventDate             DateTime  @map("event_date")
  walkInPolicy          String    @default("closed") @map("walk_in_policy")
  walkInThreshold       Int       @default(200) @map("walk_in_threshold")
  actualEndedAt         DateTime? @map("actual_ended_at")
  actualEndedBy         String?   @map("actual_ended_by")
  status                String    @default("planning")
  clientPortalStatus    String    @default("locked") @map("client_portal_status")
  clientEventDayViewEnabled Boolean @default(false) @map("client_event_day_view_enabled")
  readiness             String    @default("Conforme pending")
  archived              Boolean   @default(false)
  archivedAt            DateTime? @map("archived_at")
  archiveOverrideReason String?   @map("archive_override_reason")
  archiveOverrideBy     String?   @map("archive_override_by")
  archiveChecklist      Json      @default("{}") @map("archive_checklist")
  proposalClientStatus  String    @default("pending") @map("proposal_client_status")
  proposalRevisionCount Int       @default(0) @map("proposal_revision_count")
  proposalReviewedAt    DateTime? @map("proposal_reviewed_at")
  proposalReviewedBy    String?   @map("proposal_reviewed_by")
  freezeStatus          String    @default("open") @map("freeze_status")
  freezeAt              DateTime? @map("freeze_at")
  freezeDeadlineAt      DateTime? @map("freeze_deadline_at")
  freezeReason          String    @default("") @map("freeze_reason")
  floorPlanStatus       String    @default("not_started") @map("floor_plan_status")
  floorPlanId           String?   @map("floor_plan_id")
  floorPlanSubmittedAt  DateTime? @map("floor_plan_submitted_at")
  floorPlanReviewedAt   DateTime? @map("floor_plan_reviewed_at")
  floorPlanProjectionVersion Int @default(0) @map("floor_plan_projection_version")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  inquiry                     OpsInquiry                      @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  documents                   OpsDocument[]
  briefings                   OpsBriefing[]
  complianceRules             OpsComplianceRule[]
  complianceChecks            OpsComplianceCheck[]
  complianceRuns              OpsComplianceRun[]
  complianceRisks             OpsComplianceRisk[]
  postEventDocuments          OpsPostEventDocument[]
  wrapUpRecords               OpsEventWrapUp[]
  eventInsights               OpsEventInsight[]
  decisionRecords             OpsEventDecision[]
  freezeExceptions            OpsEventFreezeException[]
  addenda                     OpsAddendum[]
  addendumImpacts             OpsAddendumImpact[]
  ocularVisitRequest          OpsOcularVisitRequest?

  @@index([inquiryId], map: "events_inquiry_id_idx")
  @@index([status, eventDate], map: "events_status_event_date_idx")
  @@index([eventDate, id], map: "events_event_date_id_idx")
  @@index([eventDate, id], where: { archived: false }, map: "events_active_event_date_idx")
  @@map("events")
  @@schema("event_lifecycle")
}

model OpsOcularVisitRequest {
  id           String    @id
  eventId      String    @unique(map: "ocular_visit_requests_event_id_key") @map("event_id")
  status       String    @default("requested")
  clientNote   String?   @map("client_note")
  requestedAt  DateTime? @map("requested_at")
  scheduledAt  DateTime? @map("scheduled_at")
  completedAt  DateTime? @map("completed_at")
  waiverReason String?   @map("waiver_reason")
  waivedAt     DateTime? @map("waived_at")
  waivedBy     String?   @map("waived_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  event OpsEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status, requestedAt], map: "ocular_visit_requests_status_requested_at_idx")
  @@map("ocular_visit_requests")
  @@schema("event_lifecycle")
}

model OpsEventDecision {
  id                 String   @id
  eventId            String   @map("event_id")
  decision           String
  reason             String
  actorId            String   @map("actor_id")
  actorRole          String   @map("actor_role")
  actorName          String   @map("actor_name")
  actorEmail         String?  @map("actor_email")
  decidedAt          DateTime @default(now()) @map("decided_at")
  priorState         Json     @map("prior_state")
  financialImpact    Json     @default("{}") @map("financial_impact")
  assignmentImpact   Json     @default("{}") @map("assignment_impact")
  supplierImpact     String   @map("supplier_impact")
  notificationIntent String   @default("queued") @map("notification_intent")
  notificationReason String?  @map("notification_reason")
  storageIntent      String   @default("pending") @map("storage_intent")
  idempotencyKey     String?  @unique(map: "event_decisions_idempotency_key_key") @map("idempotency_key")

  event OpsEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, decidedAt], map: "event_decisions_event_id_decided_at_idx")
  @@map("event_decisions")
  @@schema("event_lifecycle")
}

model OpsPrivacyRequest {
  id             String    @id
  eventId        String?   @map("event_id")
  subjectType    String    @map("subject_type")
  subjectEmail   String    @default("") @map("subject_email")
  subjectName    String    @default("") @map("subject_name")
  requestType    String    @map("request_type")
  status         String    @default("submitted")
  requestNotes   String    @default("") @map("request_notes")
  reviewReason   String    @default("") @map("review_reason")
  executionNotes String    @default("") @map("execution_notes")
  createdBy      String    @map("created_by")
  reviewedBy     String?   @map("reviewed_by")
  reviewedAt     DateTime? @map("reviewed_at")
  executedBy     String?   @map("executed_by")
  executedAt     DateTime? @map("executed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")


  @@index([status, createdAt], map: "privacy_requests_status_created_at_idx")
  @@index([subjectEmail], map: "privacy_requests_subject_email_idx")
  @@index([eventId], map: "privacy_requests_event_id_idx")
  @@map("privacy_requests")
  @@schema("platform_ops")
}

model OpsPrivacyLegalHold {
  id             String    @id
  subjectType    String    @map("subject_type")
  subjectEmail   String    @default("") @map("subject_email")
  subjectName    String    @default("") @map("subject_name")
  eventId        String?   @map("event_id")
  reason         String
  placedById     String    @map("placed_by_id")
  placedByName   String    @map("placed_by_name")
  placedAt       DateTime  @default(now()) @map("placed_at")
  releaseReason  String?   @map("release_reason")
  releasedById   String?   @map("released_by_id")
  releasedByName String?   @map("released_by_name")
  releasedAt     DateTime? @map("released_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([subjectType, subjectEmail, releasedAt, eventId], map: "privacy_legal_holds_email_active_idx")
  @@index([subjectType, subjectName, releasedAt, eventId], map: "privacy_legal_holds_name_active_idx")
  @@map("privacy_legal_holds")
  @@schema("platform_ops")
}

model OpsFloorPlanDraft {
  id                  String    @id
  eventId             String    @map("event_id")
  floorPlanId         String    @unique(map: "floor_plan_drafts_floor_plan_id_key") @map("floor_plan_id")
  name                String
  status              String    @default("pmcm_draft")
  isActive            Boolean   @default(false) @map("is_active")
  sourceType          String    @default("blank") @map("source_type")
  createdByRole       String    @map("created_by_role")
  clientPreference    Json?     @map("client_preference")
  submittedSnapshot   Json?     @map("submitted_snapshot")
  approvedSnapshot    Json?     @map("approved_snapshot")
  submittedAt         DateTime? @map("submitted_at")
  reviewedAt          DateTime? @map("reviewed_at")
  approvedAt          DateTime? @map("approved_at")
  submittedSnapshotAt DateTime? @map("submitted_snapshot_at")
  approvedSnapshotAt  DateTime? @map("approved_snapshot_at")
  revisionComment     String    @default("") @map("revision_comment")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  floorPlan FloorPlan @relation("OpsDraftLayout", fields: [floorPlanId], references: [id], onDelete: Cascade)

  @@index([eventId, status], map: "floor_plan_drafts_event_id_status_idx")
  @@index([eventId, isActive], map: "floor_plan_drafts_event_id_is_active_idx")
  @@unique([eventId], where: { isActive: true }, map: "floor_plan_drafts_one_active_per_event_key")
  @@map("floor_plan_drafts")
  @@schema("floorplan")
}

// Per-event sequence for projecting Floorplan-owned state onto the Lifecycle event record.
// eventId is an external reference: the context boundary deliberately has no cross-schema FK.
model OpsFloorPlanProjectionClock {
  eventId   String   @id @map("event_id")
  version   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("floor_plan_projection_clocks")
  @@schema("floorplan")
}

model OpsDocument {
  id                String   @id
  eventId           String   @map("event_id")
  type              String
  fileName          String   @map("file_name")
  status            String   @default("submitted")
  mimeType          String?  @map("mime_type")
  sizeBytes         Int?     @map("size_bytes")
  generatedFileName String?  @map("generated_file_name")
  validationStatus  String   @default("accepted") @map("validation_status")
  rejectionReason   String?  @map("rejection_reason")
  storageBucket     String?  @map("storage_bucket")
  storageKey        String?  @map("storage_key")
  uploadedByRole    String?  @map("uploaded_by_role")
  uploadedAt        DateTime @default(now()) @map("uploaded_at")

  event                 OpsEvent                  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, type], map: "documents_event_id_type_idx")
  @@map("documents")
  @@schema("event_lifecycle")
}

model OpsBriefing {
  id                  String   @id
  eventId             String   @map("event_id")
  venue               String
  guestCount          Int      @map("guest_count")
  budgetRange         String   @map("budget_range")
  serviceRequirements Json     @default("[]") @map("service_requirements")
  notes               String   @default("")
  confirmedDate       DateTime? @map("confirmed_date")
  confirmedStartTime  String?   @map("confirmed_start_time")
  confirmedEndTime    String?   @map("confirmed_end_time")
  program             Json      @default("[]")
  moodAndStyling      String    @default("") @map("mood_and_styling")
  stylingBudget       Int?      @map("styling_budget")
  submittedAt         DateTime @default(now()) @map("submitted_at")

  event OpsEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, submittedAt], map: "briefings_event_id_submitted_at_idx")
  @@map("briefings")
  @@schema("event_lifecycle")
}

model OpsCostEstimate {
  id           String   @id
  eventId      String   @map("event_id")
  budgetAmount Int      @map("budget_amount")
  totalAmount  Int      @map("total_amount")
  status       String   @default("draft")
  notes        String   @default("")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  lines        OpsCostEstimateLine[]
  proposals    OpsProposalVersion[]
  @@unique([id, eventId], map: "cost_estimates_id_event_id_key")
  @@index([eventId, createdAt], map: "cost_estimates_event_id_created_at_idx")
  @@map("cost_estimates")
  @@schema("commercial")
}

model OpsCostEstimateLine {
  id             String @id
  estimateId     String @map("estimate_id")
  category       String
  description    String
  quantity       Decimal @db.Decimal(12, 3)
  unitAmount     Int @map("unit_amount")
  totalAmount    Int @map("total_amount")
  sourceLineId   String? @map("source_line_id")
  estimate       OpsCostEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  @@index([estimateId, category], map: "cost_estimate_lines_estimate_id_category_idx")
  @@map("cost_estimate_lines")
  @@schema("commercial")
}

model OpsProposalVersion {
  id             String   @id
  eventId        String   @map("event_id")
  costEstimateId String   @map("cost_estimate_id")
  versionNumber  Int      @map("version_number")
  title          String
  summary        String   @default("")
  totalAmount    Int      @map("total_amount")
  status         String   @default("draft")
  revisionNote   String   @default("") @map("revision_note")
  issuedAt       DateTime? @map("issued_at")
  createdAt      DateTime @default(now()) @map("created_at")
  costEstimate   OpsCostEstimate @relation(fields: [costEstimateId, eventId], references: [id, eventId], onDelete: Restrict, map: "proposal_versions_cost_estimate_event_fkey")
  @@unique([eventId, versionNumber], map: "proposal_versions_event_version_key")
  @@index([eventId, status], map: "proposal_versions_event_id_status_idx")
  @@map("proposal_versions")
  @@schema("commercial")
}

model OpsEventFreezeException {
  id              String    @id
  eventId         String    @map("event_id")
  requestedChange String    @map("requested_change")
  reason          String
  status          String    @default("pending")
  requestedBy     String    @map("requested_by")
  decidedBy       String?   @map("decided_by")
  decisionNote    String?   @map("decision_note")
  requestedAt     DateTime  @default(now()) @map("requested_at")
  decidedAt       DateTime? @map("decided_at")
  event           OpsEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
