generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "floorplan", "identity", "event_core", "supplier_ops", "staffing_ops", "finance_ops", "compliance_ops", "guest_ops", "trust_ops"]
}

model FloorPlan {
  id             String   @id
  name           String
  venue          String   @default("")
  width          Int      @default(1400)
  height         Int      @default(900)
  gridSize       Int      @default(20) @map("grid_size")
  pax            Int      @default(0)
  ownerId        String   @map("owner_id")
  templateId     String?  @map("template_id")
  eventId        String?  @map("event_id")
  objects        Json     @default("[]")
  guests         Json     @default("[]")
  suppliers      Json     @default("[]")
  seats          Json     @default("[]")
  seatCategories Json     @default("[]") @map("seat_categories")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  objectRows FloorPlanObject[]
  asTemplate VenueTemplate?     @relation("TemplateBaseLayout")
  asEvent    EventInstance?     @relation("EventLayout")
  opsDraft   OpsFloorPlanDraft? @relation("OpsDraftLayout")

  @@map("floor_plans")
  @@schema("floorplan")
}

model FloorPlanObject {
  floorPlanId String   @map("floor_plan_id")
  objectId    String   @map("object_id")
  kind        String
  zIndex      Int      @default(0) @map("z_index")
  objectData  Json     @map("object_data")
  svgMarkup   String?  @map("svg_markup")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  floorPlan FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)

  @@id([floorPlanId, objectId])
  @@map("floor_plan_objects")
  @@schema("floorplan")
}

model VenueTemplate {
  id                String   @id
  ownerId           String   @map("owner_id")
  name              String
  description       String   @default("")
  venue             String   @default("")
  venueRules        String   @default("") @map("venue_rules")
  permanentFeatures Json     @default("[]") @map("permanent_features")
  floorPlanId       String   @unique @map("floor_plan_id")
  pax               Int      @default(0)
  includeGuests     Boolean  @default(false) @map("include_guests")
  includeSuppliers  Boolean  @default(false) @map("include_suppliers")
  guests            Json     @default("[]")
  suppliers         Json     @default("[]")
  sourceType        String   @default("custom") @map("source_type")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  floorPlan FloorPlan       @relation("TemplateBaseLayout", fields: [floorPlanId], references: [id], onDelete: Cascade)
  events    EventInstance[]

  @@map("venue_templates")
  @@schema("floorplan")
}

model EventInstance {
  id          String   @id
  ownerId     String   @map("owner_id")
  templateId  String   @map("template_id")
  floorPlanId String   @unique @map("floor_plan_id")
  name        String
  startsAt    DateTime @map("starts_at")
  status      String   @default("draft")
  createdAt   DateTime @default(now()) @map("created_at")

  template  VenueTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  floorPlan FloorPlan          @relation("EventLayout", fields: [floorPlanId], references: [id], onDelete: Cascade)
  snapshot  PublishedSnapshot?

  @@index([templateId], map: "event_instances_template_id_idx")
  @@map("event_instances")
  @@schema("floorplan")
}

model PublishedSnapshot {
  id          String   @id
  slug        String   @unique
  eventId     String   @unique @map("event_id")
  floorPlan   Json     @map("floor_plan")
  publishedAt DateTime @default(now()) @map("published_at")

  event EventInstance @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("published_snapshots")
  @@schema("floorplan")
}

model OpsUser {
  id               String    @id
  name             String
  email            String    @unique(map: "users_email_key")
  password         String
  role             String
  organization     String
  approvalStatus   String    @default("pending") @map("approval_status")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockoutCount     Int       @default(0) @map("lockout_count")
  lockedUntil      DateTime? @map("locked_until")
  permanentLockout Boolean   @default(false) @map("permanent_lockout")
  lastLoginAt      DateTime? @map("last_login_at")
  twoFactorSecret  String?   @map("two_factor_secret")
  createdAt        DateTime  @default(now()) @map("created_at")

  loginHistory       OpsLoginHistory[]
  coordinatorProfile OpsCoordinator?

  @@map("users")
  @@schema("identity")
}

model OpsApprovalRequest {
  id                       String   @id
  userId                   String   @map("user_id")
  name                     String
  email                    String
  role                     String
  organization             String
  status                   String   @default("pending")
  privacyConsentAccepted   Boolean  @default(false) @map("privacy_consent_accepted")
  privacyNoticeVersion     String   @default("") @map("privacy_notice_version")
  marketingConsentAccepted Boolean  @default(false) @map("marketing_consent_accepted")
  requestedAt              DateTime @default(now()) @map("requested_at")

  @@index([status, requestedAt], map: "approval_requests_status_requested_at_idx")
  @@map("approval_requests")
  @@schema("identity")
}

model OpsInquiry {
  id                        String    @id
  clientName                String    @map("client_name")
  companyName               String    @default("") @map("company_name")
  email                     String
  eventName                 String    @map("event_name")
  eventType                 String    @default("Event") @map("event_type")
  eventDate                 DateTime  @map("event_date")
  clientType                String    @map("client_type")
  source                    String    @default("Website")
  channel                   String?
  normalizedEmail           String    @default("") @map("normalized_email")
  referralDetails           String    @default("") @map("referral_details")
  loggedByRole              String?   @map("logged_by_role")
  loggedByName              String?   @map("logged_by_name")
  duplicateOfInquiryId      String?   @map("duplicate_of_inquiry_id")
  previousDeclinedInquiryId String?   @map("previous_declined_inquiry_id")
  previousDeclineReason     String?   @map("previous_decline_reason")
  message                   String    @default("")
  status                    String    @default("new")
  declineReason             String?   @map("decline_reason")
  acceptedAt                DateTime? @map("accepted_at")
  pendingAt                 DateTime? @map("pending_at")
  declinedAt                DateTime? @map("declined_at")
  conformeSentAt            DateTime? @map("conforme_sent_at")
  conformeSignedAt          DateTime? @map("conforme_signed_at")
  portalActivatedAt         DateTime? @map("portal_activated_at")
  followUpIntervalDays      Int       @default(3) @map("follow_up_interval_days")
  lastConformeReminderAt    DateTime? @map("last_conforme_reminder_at")
  portalInvitationStatus    String    @default("not_sent") @map("portal_invitation_status")
  portalInvitationSentAt    DateTime? @map("portal_invitation_sent_at")
  portalInvitationOpenedAt  DateTime? @map("portal_invitation_opened_at")
  portalInvitationExpiresAt DateTime? @map("portal_invitation_expires_at")
  privacyConsentAccepted    Boolean   @default(false) @map("privacy_consent_accepted")
  privacyNoticeVersion      String    @default("") @map("privacy_notice_version")
  marketingConsentAccepted  Boolean   @default(false) @map("marketing_consent_accepted")
  createdAt                 DateTime  @default(now()) @map("created_at")

  events OpsEvent[]

  @@index([status, createdAt], map: "inquiries_status_created_at_idx")
  @@index([source, createdAt], map: "inquiries_source_created_at_idx")
  @@index([clientType, createdAt], map: "inquiries_client_type_created_at_idx")
  @@index([normalizedEmail, eventDate], map: "inquiries_normalized_email_event_date_idx")
  @@index([duplicateOfInquiryId], map: "inquiries_duplicate_of_inquiry_id_idx")
  @@index([previousDeclinedInquiryId], map: "inquiries_previous_declined_inquiry_id_idx")
  @@map("inquiries")
  @@schema("event_core")
}

model OpsEvent {
  id                    String    @id
  inquiryId             String    @map("inquiry_id")
  clientName            String    @map("client_name")
  eventName             String    @map("event_name")
  eventDate             DateTime  @map("event_date")
  actualEndedAt         DateTime? @map("actual_ended_at")
  actualEndedBy         String?   @map("actual_ended_by")
  status                String    @default("planning")
  clientPortalStatus    String    @default("locked") @map("client_portal_status")
  readiness             String    @default("Conforme pending")
  archived              Boolean   @default(false)
  archivedAt            DateTime? @map("archived_at")
  archiveOverrideReason String?   @map("archive_override_reason")
  archiveOverrideBy     String?   @map("archive_override_by")
  archiveChecklist      Json      @default("{}") @map("archive_checklist")
  proposalClientStatus  String    @default("pending") @map("proposal_client_status")
  proposalRevisionCount Int       @default(0) @map("proposal_revision_count")
  proposalReviewedAt    DateTime? @map("proposal_reviewed_at")
  proposalReviewedBy    String?   @map("proposal_reviewed_by")
  floorPlanStatus       String    @default("not_started") @map("floor_plan_status")
  floorPlanId           String?   @map("floor_plan_id")
  floorPlanSubmittedAt  DateTime? @map("floor_plan_submitted_at")
  floorPlanReviewedAt   DateTime? @map("floor_plan_reviewed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  inquiry                     OpsInquiry                      @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  documents                   OpsDocument[]
  briefings                   OpsBriefing[]
  supplierQuoteRequests       OpsSupplierQuoteRequest[]
  supplierQuotes              OpsSupplierQuote[]
  supplierReviews             OpsSupplierReview[]
  supplierReliabilityNotes    OpsSupplierReliabilityNote[]
  coordinatorAssignments      OpsCoordinatorAssignment[]
  eventDayTasks               OpsEventDayTask[]
  urgentIssues                OpsUrgentIssue[]
  eventDayLogs                OpsEventDayLog[]
  coordinatorReliabilityNotes OpsCoordinatorReliabilityNote[]
  complianceRules             OpsComplianceRule[]
  complianceChecks            OpsComplianceCheck[]
  billingSources              OpsBillingSource[]
  billingStatements           OpsBillingStatement[]
  paymentMilestones           OpsPaymentMilestone[]
  paymentRecords              OpsPaymentRecord[]
  postEventDocuments          OpsPostEventDocument[]
  eventInsights               OpsEventInsight[]
  guestCheckIns               OpsGuestCheckIn[]
  guestRosterEntries          OpsGuestRosterEntry[]
  guestFeedback               OpsGuestFeedback[]
  registrationPlatforms       OpsRegistrationPlatform[]
  privacyRequests             OpsPrivacyRequest[]
  auditLogs                   OpsAuditLog[]
  notificationLogs            OpsNotificationLog[]
  securityAlerts              OpsSecurityAlert[]
  aiAuditLogs                 OpsAiAuditLog[]
  aiApprovalRecords           OpsAiApprovalRecord[]
  floorPlanDrafts             OpsFloorPlanDraft[]

  @@index([inquiryId], map: "events_inquiry_id_idx")
  @@index([status, eventDate], map: "events_status_event_date_idx")
  @@map("events")
  @@schema("event_core")
}

model OpsPrivacyRequest {
  id             String    @id
  eventId        String?   @map("event_id")
  subjectType    String    @map("subject_type")
  subjectEmail   String    @default("") @map("subject_email")
  subjectName    String    @default("") @map("subject_name")
  requestType    String    @map("request_type")
  status         String    @default("submitted")
  requestNotes   String    @default("") @map("request_notes")
  reviewReason   String    @default("") @map("review_reason")
  executionNotes String    @default("") @map("execution_notes")
  createdBy      String    @default("PMCM Admin") @map("created_by")
  reviewedBy     String?   @map("reviewed_by")
  reviewedAt     DateTime? @map("reviewed_at")
  executedBy     String?   @map("executed_by")
  executedAt     DateTime? @map("executed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  event OpsEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([status, createdAt], map: "privacy_requests_status_created_at_idx")
  @@index([subjectEmail], map: "privacy_requests_subject_email_idx")
  @@index([eventId], map: "privacy_requests_event_id_idx")
  @@map("privacy_requests")
  @@schema("event_core")
}

model OpsFloorPlanDraft {
  id                  String    @id
  eventId             String    @map("event_id")
  floorPlanId         String    @unique(map: "floor_plan_drafts_floor_plan_id_key") @map("floor_plan_id")
  name                String
  status              String    @default("pmcm_draft")
  isActive            Boolean   @default(false) @map("is_active")
  sourceType          String    @default("blank") @map("source_type")
  createdByRole       String    @default("pmcm-admin") @map("created_by_role")
  clientPreference    Json?     @map("client_preference")
  submittedSnapshot   Json?     @map("submitted_snapshot")
  approvedSnapshot    Json?     @map("approved_snapshot")
  submittedAt         DateTime? @map("submitted_at")
  reviewedAt          DateTime? @map("reviewed_at")
  approvedAt          DateTime? @map("approved_at")
  submittedSnapshotAt DateTime? @map("submitted_snapshot_at")
  approvedSnapshotAt  DateTime? @map("approved_snapshot_at")
  revisionComment     String    @default("") @map("revision_comment")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  event     OpsEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  floorPlan FloorPlan @relation("OpsDraftLayout", fields: [floorPlanId], references: [id], onDelete: Cascade)

  @@index([eventId, status], map: "floor_plan_drafts_event_id_status_idx")
  @@index([eventId, isActive], map: "floor_plan_drafts_event_id_is_active_idx")
  @@map("floor_plan_drafts")
  @@schema("floorplan")
}

model OpsDocument {
  id                String   @id
  eventId           String   @map("event_id")
  type              String
  fileName          String   @map("file_name")
  status            String   @default("submitted")
  mimeType          String?  @map("mime_type")
  sizeBytes         Int?     @map("size_bytes")
  generatedFileName String?  @map("generated_file_name")
  validationStatus  String   @default("accepted") @map("validation_status")
  rejectionReason   String?  @map("rejection_reason")
  storageBucket     String?  @map("storage_bucket")
  storageKey        String?  @map("storage_key")
  uploadedByRole    String?  @map("uploaded_by_role")
  uploadedAt        DateTime @default(now()) @map("uploaded_at")

  event                 OpsEvent                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contractQuoteRequests OpsSupplierQuoteRequest[]

  @@index([eventId, type], map: "documents_event_id_type_idx")
  @@map("documents")
  @@schema("event_core")
}

model OpsBriefing {
  id                  String   @id
  eventId             String   @map("event_id")
  venue               String
  guestCount          Int      @map("guest_count")
  budgetRange         String   @map("budget_range")
  serviceRequirements Json     @default("[]") @map("service_requirements")
  notes               String   @default("")
  submittedAt         DateTime @default(now()) @map("submitted_at")

  event OpsEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, submittedAt], map: "briefings_event_id_submitted_at_idx")
  @@map("briefings")
  @@schema("event_core")
}

model OpsSupplierQuoteRequest {
  id                         String    @id
  eventId                    String    @map("event_id")
  supplierId                 String?   @map("supplier_id")
  categoryId                 String?   @map("category_id")
  supplierName               String    @map("supplier_name")
  category                   String
  message                    String    @default("")
  dueDate                    DateTime? @map("due_date")
  accessToken                String    @unique(map: "quote_requests_access_token_key") @map("access_token")
  confidentialBid            Boolean   @default(false) @map("confidential_bid")
  status                     String    @default("open")
  assignmentStatus           String    @default("pending_confirmation") @map("assignment_status")
  assignmentConfirmedAt      DateTime? @map("assignment_confirmed_at")
  readinessStatus            String    @default("not_requested") @map("readiness_status")
  readinessConfirmedAt       DateTime? @map("readiness_confirmed_at")
  readinessNotes             String    @default("") @map("readiness_notes")
  eventDayStatus             String    @default("not_started") @map("event_day_status")
  eventDayStatusAt           DateTime? @map("event_day_status_at")
  eventDayNotes              String    @default("") @map("event_day_notes")
  eventDayVerificationStatus String    @default("self_reported") @map("event_day_verification_status")
  eventDayVerifiedAt         DateTime? @map("event_day_verified_at")
  eventDayVerifiedBy         String?   @map("event_day_verified_by")
  eventDayVerificationNotes  String    @default("") @map("event_day_verification_notes")
  statusPhotoFileName        String?   @map("status_photo_file_name")
  contractDocumentId         String?   @map("contract_document_id")
  createdAt                  DateTime  @default(now()) @map("created_at")

  event            OpsEvent             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supplier         OpsSupplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  categoryRef      OpsSupplierCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  contractDocument OpsDocument?         @relation(fields: [contractDocumentId], references: [id], onDelete: SetNull)

  @@index([eventId, status], map: "quote_requests_event_id_status_idx")
  @@index([supplierId], map: "quote_requests_supplier_id_idx")
  @@index([categoryId], map: "quote_requests_category_id_idx")
  @@index([contractDocumentId], map: "quote_requests_contract_document_id_idx")
  @@map("quote_requests")
  @@schema("supplier_ops")
}

model OpsSupplierQuote {
  id                     String    @id
  eventId                String    @map("event_id")
  requestId              String?   @map("request_id")
  supplierId             String?   @map("supplier_id")
  categoryId             String?   @map("category_id")
  supplierName           String    @map("supplier_name")
  category               String
  amount                 Int
  inclusions             Json      @default("[]")
  paymentTerms           String    @default("") @map("payment_terms")
  notes                  String    @default("")
  acceptableMin          Int?      @map("acceptable_min")
  acceptableMax          Int?      @map("acceptable_max")
  outsideAcceptableRange Boolean   @default(false) @map("outside_acceptable_range")
  status                 String    @default("requested")
  revisionNumber         Int       @default(1) @map("revision_number")
  revisedAt              DateTime? @map("revised_at")
  selectedAt             DateTime? @map("selected_at")
  lockedAt               DateTime? @map("locked_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")

  event       OpsEvent             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supplier    OpsSupplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  categoryRef OpsSupplierCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([eventId, status], map: "quotes_event_id_status_idx")
  @@index([supplierId], map: "quotes_supplier_id_idx")
  @@index([categoryId], map: "quotes_category_id_idx")
  @@map("quotes")
  @@schema("supplier_ops")
}

model OpsSupplierCategory {
  id            String   @id
  slug          String   @unique(map: "supplier_categories_slug_key")
  name          String
  sortOrder     Int      @default(0) @map("sort_order")
  active        Boolean  @default(true)
  acceptableMin Int?     @map("acceptable_min")
  acceptableMax Int?     @map("acceptable_max")
  createdAt     DateTime @default(now()) @map("created_at")

  suppliers            OpsSupplier[]
  quoteRequests        OpsSupplierQuoteRequest[]
  quotes               OpsSupplierQuote[]
  reviewDimensions     OpsSupplierReviewDimension[]
  supplierApplications OpsSupplierApplication[]

  @@index([active, sortOrder], map: "supplier_categories_active_sort_order_idx")
  @@map("supplier_categories")
  @@schema("supplier_ops")
}

model OpsSupplier {
  id                String   @id
  categoryId        String   @map("category_id")
  name              String
  contactName       String   @default("") @map("contact_name")
  email             String   @default("")
  phone             String   @default("")
  tier              String   @default("pending_first_event")
  bniMember         Boolean  @default(false) @map("bni_member")
  serviceInclusions String   @default("") @map("service_inclusions")
  performanceNotes  String   @default("") @map("performance_notes")
  applicationDate   DateTime @default(now()) @map("application_date")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  category         OpsSupplierCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  quoteRequests    OpsSupplierQuoteRequest[]
  quotes           OpsSupplierQuote[]
  reviews          OpsSupplierReview[]
  reliabilityNotes OpsSupplierReliabilityNote[]
  certifications   OpsSupplierCertification[]
  application      OpsSupplierApplication?
  promotions       OpsSupplierPromotion[]

  @@index([categoryId, tier], map: "suppliers_category_id_tier_idx")
  @@index([bniMember], map: "suppliers_bni_member_idx")
  @@map("suppliers")
  @@schema("supplier_ops")
}

model OpsSupplierReview {
  id             String   @id
  supplierId     String   @map("supplier_id")
  eventId        String?  @map("event_id")
  rating         Int
  notes          String   @default("")
  reviewedBy     String   @default("PMCM Admin") @map("reviewed_by")
  idempotencyKey String?  @unique(map: "supplier_reviews_idempotency_key_key") @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  supplier         OpsSupplier                        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  event            OpsEvent?                          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  dimensionRatings OpsSupplierReviewDimensionRating[]
  promotions       OpsSupplierPromotion[]

  @@index([supplierId, createdAt], map: "supplier_reviews_supplier_id_created_at_idx")
  @@index([eventId], map: "supplier_reviews_event_id_idx")
  @@map("supplier_reviews")
  @@schema("supplier_ops")
}

model OpsSupplierReviewDimension {
  id         String   @id
  categoryId String   @map("category_id")
  slug       String
  name       String
  sortOrder  Int      @default(0) @map("sort_order")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  category OpsSupplierCategory               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  ratings  OpsSupplierReviewDimensionRating[]

  @@unique([categoryId, slug], map: "supplier_review_dimensions_category_id_slug_key")
  @@index([categoryId, active, sortOrder], map: "supplier_review_dimensions_category_id_active_sort_order_idx")
  @@map("supplier_review_dimensions")
  @@schema("supplier_ops")
}

model OpsSupplierReviewDimensionRating {
  id          String @id
  reviewId    String @map("review_id")
  dimensionId String @map("dimension_id")
  rating      Int

  review    OpsSupplierReview          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  dimension OpsSupplierReviewDimension @relation(fields: [dimensionId], references: [id], onDelete: Restrict)

  @@unique([reviewId, dimensionId], map: "supplier_review_dimension_ratings_review_id_dimension_id_key")
  @@map("supplier_review_dimension_ratings")
  @@schema("supplier_ops")
}

model OpsSupplierReliabilityNote {
  id         String   @id
  supplierId String   @map("supplier_id")
  eventId    String?  @map("event_id")
  note       String
  createdBy  String?  @map("created_by")
  idempotencyKey String? @unique(map: "supplier_reliability_notes_idempotency_key_key") @map("idempotency_key")
  createdAt  DateTime @default(now()) @map("created_at")

  supplier OpsSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  event    OpsEvent?   @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([supplierId, createdAt], map: "supplier_reliability_notes_supplier_id_created_at_idx")
  @@index([eventId], map: "supplier_reliability_notes_event_id_idx")
  @@map("supplier_reliability_notes")
  @@schema("supplier_ops")
}

model OpsSupplierCertification {
  id           String    @id
  supplierId   String    @map("supplier_id")
  fileName     String    @map("file_name")
  documentType String    @default("") @map("document_type")
  issuer       String    @default("")
  expiresAt    DateTime? @map("expires_at")
  status       String    @default("submitted")
