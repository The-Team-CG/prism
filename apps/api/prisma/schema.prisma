  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  event OpsEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId], map: "registration_platforms_event_id_idx")
  @@map("registration_platforms")
  @@schema("guest_ops")
}

model OpsAiAuditLog {
  id                    String   @id
  eventId               String?  @map("event_id")
  featureName           String   @map("feature_name")
  modelVersion          String   @map("model_version")
  dataCategories        Json     @default("[]") @map("data_categories")
  sanitizedPayload      Json     @default("{}") @map("sanitized_payload")
  zdrConfirmed          Boolean  @default(false) @map("zdr_confirmed")
  humanApprovalRequired Boolean  @default(true) @map("human_approval_required")
  humanApproved         Boolean? @map("human_approved")
  status                String   @default("blocked")
  createdAt             DateTime @default(now()) @map("created_at")

  event OpsEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId], map: "ai_audit_logs_event_id_idx")
  @@index([featureName, createdAt], map: "ai_audit_logs_feature_name_created_at_idx")
  @@index([status, createdAt], map: "ai_audit_logs_status_created_at_idx")
  @@map("ai_audit_logs")
  @@schema("trust_ops")
}

model OpsAiApprovalRecord {
  id            String    @id
  aiAuditLogId  String    @map("ai_audit_log_id")
  eventId       String?   @map("event_id")
  featureName   String    @map("feature_name")
  requestedBy   String    @default("PMCM Admin") @map("requested_by")
  humanApproved Boolean   @default(false) @map("human_approved")
  approvedBy    String?   @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  status        String    @default("pending_human_approval")
  requestedAt   DateTime  @default(now()) @map("requested_at")

  event OpsEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([aiAuditLogId], map: "ai_approval_records_ai_audit_log_id_idx")
  @@index([eventId], map: "ai_approval_records_event_id_idx")
  @@index([status, requestedAt], map: "ai_approval_records_status_requested_at_idx")
  @@map("ai_approval_records")
  @@schema("trust_ops")
}

model OpsLoginHistory {
  id            String   @id
  userId        String?  @map("user_id")
  userName      String   @map("user_name")
  userRole      String   @map("user_role")
  email         String
  status        String
  ipAddress     String   @default("system") @map("ip_address")
  device        String   @default("P.R.I.S.M")
  failureReason String?  @map("failure_reason")
  createdAt     DateTime @default(now()) @map("created_at")

  user OpsUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], map: "login_history_user_id_created_at_idx")
  @@index([email, createdAt], map: "login_history_email_created_at_idx")
  @@index([status, createdAt], map: "login_history_status_created_at_idx")
  @@map("login_history")
  @@schema("identity")
}

model OpsSecurityAlert {
  id          String    @id
  eventId     String?   @map("event_id")
  type        String
  title       String
  description String
  severity    String    @default("warning")
  status      String    @default("open")
  triggeredBy String    @default("System") @map("triggered_by")
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  event OpsEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId], map: "security_alerts_event_id_idx")
  @@index([status, createdAt], map: "security_alerts_status_created_at_idx")
  @@index([type, createdAt], map: "security_alerts_type_created_at_idx")
  @@index([severity, createdAt], map: "security_alerts_severity_created_at_idx")
  @@map("security_alerts")
  @@schema("identity")
}
