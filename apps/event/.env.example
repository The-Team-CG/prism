# P.R.I.S.M API used by browser-side PMCM event portal requests.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GUEST_PORTAL_URL=http://localhost:3003

# Vercel Services supplies same-origin browser routing through next.config.ts.
# PRISM_API_URL is a server-only service binding; never set it manually.
# NEXT_PUBLIC_PORTAL_BASE_PATH is supplied by next.config.ts in services mode.
