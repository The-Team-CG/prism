{
  "name": "@prism/event",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/dev-portal.mjs --app event --mode dev",
    "prebuild": "node ../../scripts/clean-next-dev.cjs",
    "build": "next build",
    "start": "node ../../scripts/dev-portal.mjs --app event --mode start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "node ../../scripts/clean-next-dev.cjs && tsc --noEmit",
    "lint": "cd ../.. && eslint --config eslint.config.mjs \"apps/event/src/**/*.{ts,tsx}\"",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "@prism/api-client": "*",
    "@prism/floorplan-canvas": "*",
    "@prism/portal-query": "*",
    "@prism/tokens": "*",
    "@prism/types": "*",
    "@prism/ui": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "next": "^16.4.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
