{
  "name": "@prism/client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/dev-portal.mjs --app client --mode dev",
    "prebuild": "node ../../scripts/clean-next-dev.cjs",
    "build": "next build",
    "start": "node ../../scripts/dev-portal.mjs --app client --mode start",
    "typecheck": "node ../../scripts/clean-next-dev.cjs && tsc --noEmit",
    "lint": "cd ../.. && eslint --config eslint.config.mjs \"apps/client/src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "@prism/api-client": "*",
    "@prism/floorplan-canvas": "*",
    "@prism/tokens": "*",
    "@prism/types": "*",
    "@prism/ui": "*",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.487.0",
    "next": "^16.3.8",
    "next-themes": "0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
