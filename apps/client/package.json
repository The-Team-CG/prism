{
  "name": "@prism/client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/dev-portal.mjs --app client --mode dev",
    "prebuild": "node ../../scripts/clean-next-dev.cjs",
    "build": "next build",
    "start": "node ../../scripts/dev-portal.mjs --app client --mode start",
    "typecheck": "node ../../scripts/clean-next-dev.cjs && node ../../scripts/typescript.mjs --noEmit",
    "lint": "node ../../scripts/lint.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "@prism/api-client": "*",
    "@prism/floorplan-canvas": "*",
    "@prism/tokens": "*",
    "@prism/portal-query": "*",
    "@prism/types": "*",
    "@prism/ui": "*",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "next-themes": "0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
